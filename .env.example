# Laravel-бекенд (more-sushi), звідки беруться меню та куди йдуть замовлення
NUXT_PUBLIC_API_URL=https://bot.moresushi.in.ua
# Публічна адреса сайту (canonical, og:image)
NUXT_PUBLIC_SITE_URL=https://moresushi.in.ua
# Демо промокодів (MORE10) і бонусів — вмикати, лише коли з'явиться підтримка на бекенді
NUXT_PUBLIC_FEATURES_PROMO=false
NUXT_PUBLIC_FEATURES_BONUS=false
# Секрет Measurement Protocol GA4 (GA → Адміністратор → Потоки даних → веб-потік): замовлення йдуть у GA із сервера
NUXT_GA_API_SECRET=
